# ============================================================================
# Nodemore LMS environment. Copy to .env and change EVERY value marked CHANGE.
# Generate secrets with:  openssl rand -base64 48
# ============================================================================

# Public address of the site (no trailing slash). Use https:// in production.
PUBLIC_URL=http://localhost:8088
APP_PORT=8088
# true when the site is served over HTTPS (required in production)
COOKIE_SECURE=false

# ---- Database ---------------------------------------------------------------
DB_USER=nodemore
DB_PASSWORD=CHANGE-a-long-random-database-password

# ---- Security ---------------------------------------------------------------
# Base64 value of at least 32 bytes (openssl rand -base64 48)
JWT_SECRET=CHANGE-run-openssl-rand-base64-48
# Signs private file links when STORAGE_PROVIDER=local
STORAGE_SIGNING_SECRET=CHANGE-another-long-random-value

# First Super Admin, created on first start (password: 10+ characters)
ADMIN_EMAIL=admin@nodemor.com
ADMIN_PASSWORD=CHANGE-a-strong-admin-password

# ---- File storage -------------------------------------------------------------
# local = files on the server disk (single server). s3 = Cloudflare R2 (recommended for production).
STORAGE_PROVIDER=local
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Live classes (LiveKit) -----------------------------------------------------
LIVEKIT_API_KEY=nodemore
LIVEKIT_API_SECRET=CHANGE-a-random-secret-of-at-least-32-characters
# The address BROWSERS use to reach LiveKit. Production: wss://live.yourdomain.lk
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Set true on a public server so LiveKit advertises its public IP
LIVEKIT_USE_EXTERNAL_IP=false
# IP browsers reach for media. 127.0.0.1 for local testing; your server's public IP in production.
LIVEKIT_NODE_IP=127.0.0.1

# ---- Email ------------------------------------------------------------------------
# Defaults send all mail to the Mailpit test inbox at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=NodeMor Academy <no-reply@nodemor.io>
MAIL_REPLY_TO=nodemoracademy@gmail.com

# Swagger UI at /swagger-ui.html (keep false in production)
API_DOCS_ENABLED=false
