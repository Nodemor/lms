# =====================================================================
# Production settings: copy to /opt/nodemore/.env ON THE SERVER ONLY.
# NEVER commit the real file to GitHub.  Lock it: chmod 600 /opt/nodemore/.env
# Generate secrets with:  openssl rand -base64 48
# =====================================================================
PUBLIC_URL=https://academy.nodemor.io

DB_USER=nodemore
DB_PASSWORD=CHANGE_ME_long_random

JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
STORAGE_SIGNING_SECRET=CHANGE_ME_long_random

# First Super Admin (created on the very first start only)
ADMIN_EMAIL=admin@nodemor.io
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---- Email sending through the academy Gmail ----
# SMTP_PASSWORD is a 16-letter Google "App password" (NOT the normal Gmail password).
# Create it at myaccount.google.com/apppasswords (2-Step Verification must be ON). Write it without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nodemoracademy@gmail.com
SMTP_PASSWORD=CHANGE_ME_gmail_app_password
MAIL_FROM=NodeMor Academy <nodemoracademy@gmail.com>
MAIL_REPLY_TO=nodemoracademy@gmail.com
# Gmail sends about 500 e-mails/day: keep class updates in the app only (codes and payments are still e-mailed)
MAIL_CLASS_UPDATES=false

# ---- File storage: local disk on the VPS (backed up by backup.sh) ----
STORAGE_PROVIDER=local
# Later, for many large videos, switch to Cloudflare R2:
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- Built-in video room (optional; Zoom/Meet/Teams links need nothing here) ----
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
